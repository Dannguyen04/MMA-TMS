# Copy to .env.local and fill in. Never commit real keys.

# Video pipeline: "mock" (default) simulates upload + AI processing in memory.
# "api" uploads footage to Supabase Storage and analyses it with the NestJS job API + Python worker.
NEXT_PUBLIC_VIDEO_PIPELINE=mock

# Required when NEXT_PUBLIC_VIDEO_PIPELINE=api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mock backend latency in ms (0 disables it).
MOCK_LATENCY_MS=180

# Demo sign-in (mock session cookie + one-click demo accounts). Always on in development;
# production builds refuse it unless this is "true".
# WARNING: the mock session is not real authentication — anyone can sign in as any account and
# read ALL data, including medical records. Only enable it for a private demo deployment.
# ALLOW_DEMO_AUTH=true
