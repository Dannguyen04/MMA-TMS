# Copy to .env.local and provide non-placeholder values. Never commit secrets.

# Server-only NestJS base URL. NEXT_PUBLIC_API_URL is retained only for legacy local tooling.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Outside production the app defaults to demo data and the mock video pipeline, because main's backend
# does not yet expose every endpoint the UI calls. Set both to "api" to run against a backend that does.
# Production always uses the API.
APP_DATA_MODE=demo
NEXT_PUBLIC_VIDEO_PIPELINE=api

# Server-only development bridge; must match the NestJS value. Never expose it
# through a NEXT_PUBLIC_ variable and never configure it in production.
DEMO_SESSION_EXCHANGE_SECRET=replace-with-a-local-secret

# Video storage (Supabase keys, VIDEO_MAX_SIZE_MB) is configured on the NestJS API only; the frontend never needs them.

# Optional mock service latency for explicit demo mode only.
MOCK_LATENCY_MS=180
