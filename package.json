{
    "name": "mma-tms",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "predev": "node scripts/ensure-redis.mjs",
        "dev": "concurrently -n API,WORKER,WEB -c blue,yellow,cyan \"pnpm --filter nestjs-api run start:dev\" \"python-worker\\.venv\\Scripts\\python.exe python-worker/worker.py\" \"pnpm --filter nextjs-frontend run dev\"",
        "start:services": "start_all.bat",
        "stop:services": "stop_all.bat",
        "test:full": "node scripts/test_full_suite.mjs"
    },
    "dependencies": {
        "puppeteer": "^25.10.0"
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@scarf/scarf",
            "esbuild",
            "msgpackr-extract",
            "puppeteer",
            "unrs-resolver"
        ]
    }
}
