# NestJS API Environment Variables
NODE_ENV=development
PORT=3001

# PostgreSQL (Supabase Postgres)
# Thay [YOUR-PASSWORD] bằng mật khẩu database Supabase của bạn
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wskisxkpbhisnqfpjqrm.supabase.co:5432/postgres

# Redis (local hoặc container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase
SUPABASE_URL=https://wskisxkpbhisnqfpjqrm.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=http://localhost:8081

# Swagger custom header name (optional)
APP_HEADER_LANGUAGE=x-custom-lang

# Password recovery redirect target. One exact URL, also registered in the
# Supabase project's redirect allowlist. Deliberately separate from the CORS
# origin list, which accepts wildcard and substring matches.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

# Worker Security
WORKER_SECRET_TOKEN=mma-tms-worker-local-secret-2026
