# NestJS API Environment Variables
NODE_ENV=development
PORT=3001

# PostgreSQL (Supabase Postgres)
# Thay [YOUR-PASSWORD] bằng mật khẩu database Supabase của bạn
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wskisxkpbhisnqfpjqrm.supabase.co:5432/postgres

# Redis (local hoặc container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase
SUPABASE_URL=https://wskisxkpbhisnqfpjqrm.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
VIDEO_STORAGE_BUCKET=videos
ANALYSIS_RESULTS_BUCKET=analysis-results
VIDEO_MAX_SIZE_MB=500

# CORS
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=http://localhost:8081

# Swagger custom header name (optional)
APP_HEADER_LANGUAGE=x-custom-lang

# Password recovery redirect target. One exact URL, also registered in the
# Supabase project's redirect allowlist. Deliberately separate from the CORS
# origin list, which accepts wildcard and substring matches.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

# Worker Security
WORKER_SECRET_TOKEN=mma-tms-worker-local-secret-2026

# Development only: shared with the Next.js server to exchange an existing
# demo identity for a real API session. Leave empty outside local development.
DEMO_SESSION_EXCHANGE_SECRET=

# Notifications (all optional). Commented values are the runtime defaults from
# NOTIFICATION_CONFIG_DEFAULTS in src/notifications/notifications.constant.ts;
# each must be a positive integer within NOTIFICATION_CONFIG_MAX (validated at
# startup). Units: *_MS milliseconds, *_SEC seconds, *_BYTES bytes.
# Details: README "Notifications".
# NOTIFICATION_ENQUEUE_TIMEOUT_MS=2000
# NOTIFICATION_PRODUCER_CONNECT_TIMEOUT_MS=5000
# NOTIFICATION_JOB_ATTEMPTS=5
# NOTIFICATION_JOB_BACKOFF_MS=2000
# NOTIFICATION_WORKER_CONCURRENCY=5
# NOTIFICATION_JOB_KEEP_COMPLETED_SEC=86400
# NOTIFICATION_JOB_KEEP_FAILED_SEC=604800
# NOTIFICATION_PUBLISH_TIMEOUT_MS=2000
# NOTIFICATION_PUBSUB_SUBSCRIBE_TIMEOUT_MS=5000
# NOTIFICATION_PUBSUB_SUBSCRIBE_RETRY_MS=5000
# NOTIFICATION_REDIS_SHUTDOWN_TIMEOUT_MS=3000
# NOTIFICATION_SSE_HEARTBEAT_MS=25000
# NOTIFICATION_SSE_REVALIDATE_MS=300000
# NOTIFICATION_SSE_MAX_LIFETIME_MS=3600000
# NOTIFICATION_SSE_MAX_CONNECTIONS_PER_USER=5
# NOTIFICATION_SSE_MAX_BUFFERED_BYTES=65536
# NOTIFICATION_SSE_SUBSCRIBE_TIMEOUT_MS=3000
# NOTIFICATION_SSE_RETRY_MS=5000
# NOTIFICATION_SSE_CLOSE_GRACE_MS=5000
