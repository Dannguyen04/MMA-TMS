# NestJS API Environment Variables
PORT=3001
AUTH_PROVIDER=local

# PostgreSQL (Supabase Postgres)
# Thay [YOUR-PASSWORD] bằng mật khẩu database Supabase của bạn
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Chỉ cấu hình một trong hai biến CA bên dưới khi nhà cung cấp dùng CA riêng.
# Đường dẫn tương đối được tính từ thư mục chạy tiến trình NestJS.
# DATABASE_SSL_CA_FILE=./certificates/database-ca.pem
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Redis (local hoặc container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS
FRONTEND_URL=http://localhost:3000

# Worker Security
WORKER_SECRET_TOKEN=replace-with-random-worker-secret
