# ============================================================
# Martial Arts Tracker — Root Environment Template (.env.example)
# Sao chép file này thành .env và điền các giá trị Supabase
# ============================================================

# ── Supabase Project ─────────────────────────────────────────
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ── Supabase PostgreSQL Database ─────────────────────────────
# Port 5432: Kết nối trực tiếp (Direct Session Mode)
# Thay [YOUR-PASSWORD] bằng mật khẩu database Supabase của bạn
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Chỉ cấu hình một trong hai biến CA bên dưới khi nhà cung cấp dùng CA riêng.
# Đường dẫn tương đối được tính từ thư mục chạy tiến trình NestJS.
# DATABASE_SSL_CA_FILE=./certificates/database-ca.pem
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]

# ── Service Endpoints ─────────────────────────────────────────
PORT=3001
AUTH_PROVIDER=local
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
QUEUE_NAME=video-analysis
YOLO_MODEL=yolov8n-pose.pt
WORKER_SECRET_TOKEN=replace-with-random-worker-secret

# ── E2E thật ───────────────────────────────────────────────
E2E_BASE_URL=http://localhost:13000
E2E_PASSWORD=replace-with-isolated-e2e-password
# URL của PostgreSQL cô lập chỉ dành cho suite backend có ghi dữ liệu.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/martial_arts_tracker_e2e
