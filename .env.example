# ============================================================
# Martial Arts Tracker — Root Environment Template (.env.example)
# Sao chép file này thành .env và điền các giá trị Supabase
# ============================================================

# ── Supabase Project ─────────────────────────────────────────
SUPABASE_PROJECT_REF=wskisxkpbhisnqfpjqrm
SUPABASE_URL=https://wskisxkpbhisnqfpjqrm.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Supabase PostgreSQL Database ─────────────────────────────
# Port 5432: Kết nối trực tiếp (Direct Session Mode)
# Thay [YOUR-PASSWORD] bằng mật khẩu database Supabase của bạn
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wskisxkpbhisnqfpjqrm.supabase.co:5432/postgres
DB_HOST=db.wskisxkpbhisnqfpjqrm.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]

# ── Service Endpoints ─────────────────────────────────────────
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
QUEUE_NAME=video-analysis
YOLO_MODEL=yolov8n-pose
WORKER_SECRET_TOKEN=mma-tms-worker-local-secret-2026
