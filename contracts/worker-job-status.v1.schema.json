{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mma-tms.local/contracts/worker-job-status.v1.schema.json",
  "title": "MMA-TMS worker job status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["PROCESSING", "DONE", "FAILED"] },
    "resultUrl": { "type": "string", "maxLength": 2048 },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "errorCode": { "type": "string", "maxLength": 64 },
    "errorMessage": { "type": "string", "maxLength": 500 },
    "healthAlerts": { "type": "array", "items": { "type": "object" } },
    "jointStates": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "DONE" } } },
      "then": { "required": ["resultUrl"] }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } } },
      "then": { "required": ["errorCode", "errorMessage"] }
    }
  ]
}
