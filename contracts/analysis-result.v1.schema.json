{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mma-tms.local/contracts/analysis-result.v1.schema.json",
  "title": "MMA-TMS analysis result v1",
  "type": "object",
  "required": ["schemaVersion", "meta", "frames", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "meta": { "type": "object" },
    "frames": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "kicks": { "type": "array", "items": { "type": "object" } },
    "punches": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "healthAlerts": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
