# ============================================================
# Biến môi trường cho Python Worker
# Sao chép file này thành .env và điền giá trị
# ============================================================

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
QUEUE_NAME=video-analysis

# YOLO Model: n=nhanh(CPU), s/m/l/x=chính xác hơn (cần GPU cho l, x)
YOLO_MODEL=yolov8n-pose.pt

# NestJS API URL — worker tải video và gửi kết quả qua API này (không dùng Supabase key)
NESTJS_API_URL=http://localhost:3001

# Worker settings
TMP_DIR=/tmp/martial-arts-worker
WORKER_SECRET_TOKEN=replace-with-random-worker-secret

