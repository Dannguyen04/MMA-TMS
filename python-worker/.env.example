# ============================================================
# Biến môi trường cho Python Worker
# Sao chép file này thành .env và điền giá trị
# ============================================================

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
QUEUE_NAME=video-analysis

# YOLO Model: n=nhanh(CPU), s/m/l/x=chính xác hơn (cần GPU cho l, x)
YOLO_MODEL=yolov8n-pose

# Supabase (Phase 3) — Lấy từ Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NestJS API URL (Phase 3)
NESTJS_API_URL=http://localhost:3001

# Worker settings
POLL_INTERVAL_S=2.0
TMP_DIR=/tmp/martial-arts-worker
WORKER_SECRET_TOKEN=mma-tms-worker-local-secret-2026

